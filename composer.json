{
    "name": "whitecube/laravel-media",
    "description": "Medial library for Laravel, managing model images & assets",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Whitecube\\Media\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Toon Van den Bos",
            "email": "toon@whitecube.be"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "intervention/image": "^4.1"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Whitecube\\Media\\MediaServiceProvider"
            ]
        }
    }
}
